# Server-side image upload key. Never prefix this with VITE_ and never commit the real value.
IMGBB_API_KEY=

# Upstash Redis REST credentials for durable invitations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Invitation retention. Defaults to 30 days.
INVITATION_TTL_DAYS=30

# Only use temporary memory storage when developing locally.
ALLOW_EPHEMERAL_STORAGE=true
